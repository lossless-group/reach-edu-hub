---
/** Slide 02 · The hook — the surface-area problem. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';
---

<section data-slot="02" data-variant="awm-p1" class="deck-section deck-glow" style="align-items: center; text-align: center;">
  <span class="deck-kicker">02 / 09</span>

  <p class="deck-eyebrow">The hook</p>
  <h2 class="deck-h1" style="max-width: 24ch; font-size: clamp(1.9rem, 4.4vw, 3.8rem);">
    The campaign gave us a surface-area problem: $19M to raise, dozens of
    funders, an August deadline.
    <span class="deck-gradient">Agents are how a team of three covers a big surface.</span>
  </h2>
  <p class="deck-lede" style="max-width: 60ch; margin-inline: auto;">
    $25M goal, $6M committed, founding growth-partner cohort closes August
    2026.<InlineCitation {...CITE.get('57ce95')!} /> That's not a headcount
    problem — it's a coverage problem.
  </p>
</section>
