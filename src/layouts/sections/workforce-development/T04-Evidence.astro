---
/** Slide 04 · The evidence turn — the slide a PhD will screenshot. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';

const findings = [
  { k: '+0.18', d: 'Relationship-based work-based learning (apprenticeship, co-op, mentoring) predicts job quality a decade later — and the effect persists as others fade.' },
  { k: '0', d: 'Non-relationship CTE predicts nothing: job shadowing, career majors, tech prep — not significant. The supervising-adult relationship is the active ingredient.' },
  { k: '+0.37', d: 'Training at ages 24–27: the single strongest training effect — precisely the Apprenticeship Degree’s population.' },
  { k: '+0.90', d: 'A completed postsecondary degree: the strongest predictor of lasting job quality in the entire dataset.' },
];
---

<section data-slot="04" data-variant="wd-p1" class="deck-section">
  <span class="deck-kicker">04 / 10</span>

  <div>
    <p class="deck-eyebrow mb-3">The evidence turn</p>
    <h2 class="deck-h2">
      A 3,928-person longitudinal study followed young adults for a decade —
      <span class="deck-gradient">and told us what works.</span>
      <InlineCitation {...CITE.get('679c9b')!} />
    </h2>
  </div>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
    {findings.map((f) => (
      <div class="deck-card flex flex-col gap-2">
        <span class="deck-stat" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">{f.k}</span>
        <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">{f.d}</p>
      </div>
    ))}
  </div>

  <p class="deck-lede mt-2" style="max-width: 72ch;">
    The federal auditor agrees on the delivery model — earn-and-learn: higher
    pay, little debt, better retention.<InlineCitation {...CITE.get('16a15a')!} />
    <strong style="color: var(--color-text);">The Apprenticeship Degree is the
    only model that stacks every feature the evidence endorses — at once.</strong>
  </p>
</section>
