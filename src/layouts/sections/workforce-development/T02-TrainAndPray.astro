---
/** Slide 02 · The hook — the system's own name for its failure mode. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';
---

<section data-slot="02" data-variant="wd-p1" class="deck-section deck-glow" style="align-items: center; text-align: center;">
  <span class="deck-kicker">02 / 10</span>

  <p class="deck-eyebrow">The hook</p>
  <h2 class="deck-h1" style="max-width: 22ch;">
    America's workforce system has a name for its own failure mode:
    <span class="deck-gradient">train and pray.</span>
    <InlineCitation {...CITE.get('b22ccf')!} />
  </h2>
  <p class="deck-lede" style="max-width: 64ch; margin-inline: auto;">
    Workers complete the program, collect the certificate, and hope something
    materializes. It's endemic — and the federal government now says so itself:
    fragmentation, credentials without ladders, no accountability for
    outcomes.<InlineCitation {...CITE.get('2e54ee')!} />
  </p>
</section>
