---
/**
 * Slide 09 · The moment — philanthropy reorganized around economic mobility.
 */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';

const pools = [
  { n: '$1B', k: 'NextLadder Ventures', d: '15-year fund for the economic mobility of low-income Americans — Ballmer, Gates, Stand Together, Valhalla, Overdeck.', cite: '5f42a8' },
  { n: '$600M+', k: 'Blue Meridian · Place Matters', d: 'Place-based portfolios built on economic-mobility outcomes.', cite: 'cca778' },
  { n: '$1.1B+', k: 'MacKenzie Scott, 2025 higher ed', d: 'Of a $7.2B year — HBCUs, tribal and community colleges, access orgs; elite universities bypassed entirely. Continuing into 2026.', cite: 'd1d74b' },
  { n: '2040', k: 'Lumina’s national goal', d: '75% of the labor force holding credentials of labor-market value — mobility, not enrollment, as the metric.', cite: '6aca82' },
];
---

<section data-slot="09" data-variant="um-p1" class="deck-section">
  <span class="deck-kicker">09 / 12</span>

  <div>
    <p class="deck-eyebrow mb-3">The moment</p>
    <h2 class="deck-h2">
      Philanthropy just reorganized around one outcome:
      <span class="deck-gradient">economic mobility.</span>
    </h2>
  </div>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));">
    {pools.map((p) => (
      <div class="deck-card flex flex-col gap-2">
        <span class="deck-stat" style="font-size: clamp(1.8rem, 3vw, 2.6rem);">{p.n}</span>
        <p style="font-family: var(--font-heading); font-size: clamp(1.2rem, 1.5vw, 1.5rem); font-weight: 700; color: var(--color-text); margin: 0;">{p.k}</p>
        <p style="color: var(--color-text-muted); font-size: clamp(0.98rem, 1.05vw, 1.18rem); line-height: 1.5; margin: 0;">
          {p.d}
          {CITE.get(p.cite) && <InlineCitation {...CITE.get(p.cite)!} />}
        </p>
      </div>
    ))}
  </div>

  <p class="deck-lede mt-2" style="max-width: 78ch; font-size: clamp(0.95rem, 1.3vw, 1.15rem);">
    Scott's education-to-career gifts read as a mobility screen — $42M to
    10,000 Degrees,<InlineCitation {...CITE.get('7ec216')!} /> $20M to
    JFF,<InlineCitation {...CITE.get('b585ef')!} /> $50M to Native
    Forward<InlineCitation {...CITE.get('a14f6b')!} /> — a run still live in
    2026.<InlineCitation {...CITE.get('f868ef')!} /><InlineCitation {...CITE.get('3c9545')!} />
    And the debt-free degree is a proven mega-gift category: Gottesman's $1B at
    Einstein,<InlineCitation {...CITE.get('3bc2ca')!} /> Bloomberg's $1B at
    Hopkins.<InlineCitation {...CITE.get('1a4b17')!} />
    <strong style="color: var(--color-text);">Both in medicine. Nobody has
    written that check for the 40 million working adults.</strong>
  </p>
</section>
