---
/** Slide 06 · One life: Arlie — the story slide (same chart the upward-mobility deck opens with). */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';

const arc = [
  { year: '2001', d: 'Enrolls in college; leaves eighteen months short when family obligations make full-time study impossible.' },
  { year: '2003–22', d: 'Two decades as a classroom aide and a single mom of four — in classrooms daily, unable to afford going back.' },
  { year: '2022', d: 'Enrolls at Reach. Keeps her full-time job and benefits; coursework counts her experience and daily work.' },
  { year: '2024', d: 'Steps into her own classroom at roughly double her aide salary — in the district she served for twenty years.' },
];
---

<section data-slot="06" data-variant="rib-p1" class="deck-section">
  <span class="deck-kicker">06 / 11</span>

  <div>
    <p class="deck-eyebrow mb-3">One life</p>
    <h2 class="deck-h2">
      Arlie: her job became her degree, her degree made her a teacher —
      <span class="deck-gradient">and her salary doubled.</span>
      <InlineCitation {...CITE.get('57ce95')!} />
    </h2>
  </div>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
    {arc.map((step) => (
      <div class="deck-card flex flex-col gap-2">
        <span class="deck-stat" style="font-size: clamp(1.6rem, 2.6vw, 2.2rem);">{step.year}</span>
        <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">{step.d}</p>
      </div>
    ))}
  </div>

  <p class="deck-lede mt-2" style="max-width: 76ch; font-size: clamp(0.95rem, 1.3vw, 1.15rem);">
    Read it the way a rural economist would: for twenty years the town had a
    committed educator it couldn't credential and a wage it couldn't raise.
    The fix was never recruiting from somewhere else — she was already sitting
    in the library. Multiply Arlie by every education-desert county with a
    school full of aides: <strong style="color: var(--color-text);">the raise
    is real, and it never left town.</strong>
  </p>
</section>
