---
/** Slide 02 · The hook — a stack nobody built. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';
---

<section data-slot="02" data-variant="nf-p1" class="deck-section deck-glow" style="align-items: center; text-align: center;">
  <span class="deck-kicker">02 / 10</span>

  <p class="deck-eyebrow">The hook</p>
  <h2 class="deck-h1" style="max-width: 20ch;">
    The Apprenticeship Degree runs on a different stack —
    <span class="deck-gradient">and nobody built it.</span>
  </h2>
  <p class="deck-lede" style="max-width: 64ch; margin-inline: auto;">
    A degree where day-to-day work <em>is</em> the curriculum needs software
    few incumbents ever built: work-and-learning integration, employer
    visibility, chunked assessment for people whose learning windows are shift
    breaks and commutes — all accreditation-legible.<InlineCitation {...CITE.get('4847ba')!} />
    Legacy LMS, SIS, and online-program platforms each cover a slice. None
    cover the whole.
  </p>
</section>
