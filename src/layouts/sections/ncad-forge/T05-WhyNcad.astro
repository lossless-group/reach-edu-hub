---
/** Slide 05 · Why NCAD is the only right home. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';
---

<section data-slot="05" data-variant="nf-p1" class="deck-section">
  <span class="deck-kicker">05 / 10</span>

  <div>
    <p class="deck-eyebrow mb-3">The home</p>
    <h2 class="deck-h2">
      One network, one lab —
      <span class="deck-gradient">so no member rebuilds what another already proved.</span>
    </h2>
  </div>

  <p class="deck-lede mt-2" style="max-width: 76ch;">
    NCAD — the National Center for the Apprenticeship Degree, launched by
    Reach — already runs partnership development and employer engagement
    across a member network,<InlineCitation {...CITE.get('97559d')!} /><InlineCitation {...CITE.get('a42a6b')!} /><InlineCitation {...CITE.get('ef66be')!} />
    anchoring the 3-million-completions-by-2035
    moonshot.<InlineCitation {...CITE.get('4aedc1')!} /><InlineCitation {...CITE.get('57ce95')!} />
    Many institutions hit the same stack gaps independently; a neutral center
    pools the prototypes so the network compounds instead of duplicating.
  </p>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">SHARED PROBLEM</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">Every member needs work↔credit mapping, employer visibility, chunked assessment, evidence capture.</p>
    </div>
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">NEUTRAL CENTER</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">Prototypes circulate through NCAD; no single member owns or gates the commons.</p>
    </div>
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">COMPOUNDING NETWORK</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">Each proof lifts every current and future member of the apprenticeship-degree movement at once.</p>
    </div>
  </div>
</section>
