---
/** Slide 03 · The model transfers — teaching proved it; health received it; frontier is next. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';
---

<section data-slot="03" data-variant="fjd-p1" class="deck-section">
  <span class="deck-kicker">03 / 09</span>

  <div>
    <p class="deck-eyebrow mb-3">The chassis</p>
    <h2 class="deck-h2">
      The ABCs took an aide to teacher-of-record with a 65–110% raise.
      <span class="deck-gradient">Frontier fields are next.</span>
    </h2>
  </div>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">FIELD-AGNOSTIC STRUCTURE</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1.02rem, 1.15vw, 1.25rem); line-height: 1.55; margin: 0;">
        Affordability by design ($75/month, zero debt) · based in the workplace ·
        credit for work. Five years of teaching outcomes — 93% retention, 70%
        on-time completion, a ~2.4 measured effect size on
        income.<InlineCitation {...CITE.get('57ce95')!} />
      </p>
    </div>
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">PAYLOAD #2 SHIPPED</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1.02rem, 1.15vw, 1.25rem); line-height: 1.55; margin: 0;">
        The Apprenticeship College of Health proves the chassis carries new
        payloads — nursing assistants stepping up, the same
        ABCs.<InlineCitation {...CITE.get('3f891a')!} />
      </p>
    </div>
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">THE BASELINE OUTCOME</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1.02rem, 1.15vw, 1.25rem); line-height: 1.55; margin: 0;">
        Per the U.S. Department of Labor: 93% of apprentices who complete a
        Registered Apprenticeship retain employment, with an average annual
        salary of $77,000.<InlineCitation {...CITE.get('74d051')!} />
      </p>
    </div>
  </div>
</section>
