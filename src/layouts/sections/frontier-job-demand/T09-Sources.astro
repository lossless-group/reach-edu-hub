---
/** Slide 09 · Sources — deck-wide citation list in appearance order. */
import SourcesPager from '@components/citations/SourcesPager.astro';
import { SOURCES } from './citations';
---

<section data-slot="09" data-variant="fjd-p1" class="deck-section" style="justify-content: flex-start; height: var(--deck-height, 100vh);">
  <span class="deck-kicker">09 / 09</span>

  <div>
    <p class="deck-eyebrow mb-3">Receipts</p>
    <h2 class="deck-h2">Every number in this deck, <span class="deck-gradient">sourced.</span></h2>
    <p class="deck-lede mt-3" style="max-width: 70ch; font-size: 1rem;">
      Citations carry stable hex codes in the per-client registry; the [n]
      numbering matches every inline marker, in order of first appearance. All
      figures verified against primary sources 2026-07-28 — including the
      corrections that verification forced (superseded studies replaced,
      global figures labeled global, one fabricated stat dropped).
    </p>
  </div>

  <SourcesPager citations={SOURCES} title="Sources" />
</section>
