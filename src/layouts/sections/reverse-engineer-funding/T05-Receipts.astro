---
/** Slide 05 · The receipts — the campaign's anchors prove the method. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';
---

<section data-slot="05" data-variant="ref-p1" class="deck-section">
  <span class="deck-kicker">05 / 10</span>

  <div>
    <p class="deck-eyebrow mb-3">It already worked</p>
    <h2 class="deck-h2">
      Carnegie's pattern said Delta, so the ask said Delta —
      <span class="deck-gradient">and $2M landed.</span>
    </h2>
  </div>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-stat" style="font-size: clamp(2rem, 3.6vw, 3rem);">$2M</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">
        Carnegie Corporation anchors the Delta expansion — landed where the
        funder's pattern and Reach's work overlap, not from a generic
        application.<InlineCitation {...CITE.get('0a146a')!} />
      </p>
    </div>
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-stat" style="font-size: clamp(2rem, 3.6vw, 3rem);">$1M</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">
        Schusterman Family Philanthropies followed as the second anchor of the
        growth-capital campaign.<InlineCitation {...CITE.get('57ce95')!} />
      </p>
    </div>
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-stat" style="font-size: clamp(2rem, 3.6vw, 3rem);">$6M / $25M</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1rem, 1.1vw, 1.2rem); line-height: 1.5; margin: 0;">
        Committed, with ~$3M more in motion and an August 2026 founding-cohort
        close.<InlineCitation {...CITE.get('57ce95')!} />
      </p>
    </div>
  </div>
</section>
