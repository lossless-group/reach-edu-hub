---
/** Slide 05 · The pedagogy caught up — and the vehicle exists. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';
---

<section data-slot="05" data-variant="aln-p1" class="deck-section">
  <span class="deck-kicker">05 / 12</span>

  <div>
    <p class="deck-eyebrow mb-3">The good news</p>
    <h2 class="deck-h2">
      The science of reading rebuilt children's literacy. It's now reaching
      adults — <span class="deck-gradient">and the delivery vehicle already exists.</span>
    </h2>
  </div>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">THE EVIDENCE BASE</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1.02rem, 1.15vw, 1.25rem); line-height: 1.55; margin: 0;">
        The validated science-of-reading base is being adapted for adult
        learners,<InlineCitation {...CITE.get('cd9feb')!} /> and IES evidence
        reviews catalog contextualized, work-embedded numeracy strategies that
        outperform decontextualized drill.<InlineCitation {...CITE.get('95f776')!} />
      </p>
    </div>
    <div class="deck-card flex flex-col gap-2">
      <span class="deck-chip">THE MISSING PIECE — SOLVED</span>
      <p style="color: var(--color-text-muted); font-size: clamp(1.02rem, 1.15vw, 1.25rem); line-height: 1.55; margin: 0;">
        What foundational-skills instruction always lacked was a vehicle: a
        place where working adults are <em>already</em> enrolled, persisting,
        and applying skills daily. The Apprenticeship Degree teaches in the
        flow of work by design.<InlineCitation {...CITE.get('57ce95')!} />
      </p>
    </div>
  </div>
</section>
