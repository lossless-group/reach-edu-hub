---
/** Slide 07 · The vehicle's numbers — not a program that needs students. */
import InlineCitation from '@components/citations/InlineCitation.astro';
import { CITE } from './citations';

const kpis = [
  { n: '3,400+', d: 'candidates across 8 states' },
  { n: '93%', d: 'retention post first term' },
  { n: '70%', d: 'on-time completion vs ~50% nationally' },
  { n: '65%', d: 'Pell-eligible · 48% of color · 36% rural' },
  { n: '$75/mo', d: 'maximum out-of-pocket, zero debt' },
  { n: '65–110%', d: 'wage gains at licensure' },
];
---

<section data-slot="07" data-variant="aln-p1" class="deck-section">
  <span class="deck-kicker">07 / 12</span>

  <div>
    <p class="deck-eyebrow mb-3">The vehicle</p>
    <h2 class="deck-h2">
      We're not proposing a literacy program that needs students.
      <span class="deck-gradient">We have 3,400 — with 93% retention.</span>
      <InlineCitation {...CITE.get('57ce95')!} />
    </h2>
  </div>

  <div class="deck-grid mt-2" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
    {kpis.map((k) => (
      <div class="deck-card flex flex-col gap-1" style="padding: clamp(0.9rem, 1.4vw, 1.2rem);">
        <span class="deck-stat" style="font-size: clamp(1.5rem, 2.6vw, 2.2rem);">{k.n}</span>
        <p style="color: var(--color-text-muted); font-size: clamp(0.95rem, 1vw, 1.15rem); line-height: 1.4; margin: 0;">{k.d}</p>
      </div>
    ))}
  </div>

  <p class="deck-lede mt-2" style="max-width: 72ch;">
    Add a measured foundational-skills layer to this machine and every point
    of literacy/numeracy gain compounds into the wage outcome the evidence
    promises.<InlineCitation {...CITE.get('28f12b')!} />
  </p>
</section>
