---
/**
 * SourcesPager — a 16:9-safe wrapper for the deck-final Sources list.
 *
 * The naive Sources slide overflowed the viewport (breaking scroll-snap
 * rhythm). This constrains the list to the slide's remaining height and adds
 * paginated ▲/▼ controls that scroll the list one "page" (one viewport of
 * list) at a time, with a page counter. Trackpad/wheel scrolling inside the
 * list also works; `overscroll-behavior: contain` stops an accidental snap
 * to the next deck slide while reading.
 *
 * Tokens only (deck-primitives / theme.css Tier-2), so light/dark/vibrant
 * work with no extra classes.
 */
import type { IndexedCitation } from '@lib/citations/types';
import Sources from './Sources.astro';

interface Props {
  citations: IndexedCitation[];
  title?: string;
}

const { citations, title = 'Sources' } = Astro.props;
---

<div class="sources-pager">
  <div class="sources-pager__viewport" data-sources-viewport tabindex="0">
    <Sources citations={citations} title={title} />
  </div>

  <div class="sources-pager__controls" role="group" aria-label="Scroll sources list">
    <button type="button" class="sources-pager__btn" data-dir="-1" aria-label="Previous page of sources">▲</button>
    <span class="sources-pager__page" data-sources-page>1 / 1</span>
    <button type="button" class="sources-pager__btn" data-dir="1" aria-label="Next page of sources">▼</button>
  </div>
</div>

<style>
  .sources-pager {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sources-pager__viewport {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 0 clamp(0.75rem, 1.5vw, 1.25rem);
    background: color-mix(in srgb, var(--color-surface) 24%, transparent);
  }
  .sources-pager__viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .sources-pager__controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .sources-pager__btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-surface) 40%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .sources-pager__btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .sources-pager__btn:disabled {
    opacity: 0.35;
    cursor: default;
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .sources-pager__page {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    min-width: 4.5ch;
    text-align: center;
  }
</style>

<script>
  function wirePager(pager: Element) {
    const viewport = pager.querySelector<HTMLElement>('[data-sources-viewport]');
    const counter = pager.querySelector<HTMLElement>('[data-sources-page]');
    const buttons = pager.querySelectorAll<HTMLButtonElement>('[data-dir]');
    if (!viewport || !counter) return;

    const pageCount = () => Math.max(1, Math.ceil(viewport.scrollHeight / viewport.clientHeight));
    const pageIndex = () =>
      Math.min(pageCount(), Math.round(viewport.scrollTop / viewport.clientHeight) + 1);

    const render = () => {
      counter.textContent = `${pageIndex()} / ${pageCount()}`;
      buttons.forEach((b) => {
        const dir = Number(b.dataset.dir);
        b.disabled =
          dir < 0
            ? viewport.scrollTop <= 1
            : viewport.scrollTop + viewport.clientHeight >= viewport.scrollHeight - 1;
      });
    };

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        viewport.scrollBy({ top: Number(b.dataset.dir) * viewport.clientHeight * 0.92, behavior: 'smooth' });
      });
    });

    viewport.addEventListener('scroll', render, { passive: true });
    window.addEventListener('resize', render);
    render();
  }

  document.querySelectorAll('.sources-pager').forEach(wirePager);
</script>
