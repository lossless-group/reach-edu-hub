---
/**
 * /scroll/upward-mobility/um-p1/ — "Upward Mobility: The Mobility Engine"
 *
 * Pitch-generation strategy deck (2026-07-28). Narrative source:
 * context-v/narratives/strategies/upward-mobility/pitch.md — every figure
 * verified against primary sources; citations carry canonical hex codes from
 * context-v/narratives/citations/registry.csv, rendered as sequential [n]
 * markers ordered by first appearance (see ../../../layouts/sections/
 * upward-mobility/citations.ts).
 *
 * Design: token-driven deck-primitives.css — Tier-2 semantic + fx tokens only,
 * so light / dark / vibrant work with no per-element variant classes.
 */
import '../../../../styles/global.css';
import '../../../../styles/theme.css';
import '../../../../styles/deck-primitives.css';
import Header from '../../../../components/basics/Header.astro';
import MetaTags from '../../../../components/basics/MetaTags.astro';
import PageAsDeckWrapper from '../../../../layouts/PageAsDeckWrapper.astro';
import DeckOverlayScrollUI from '@dididecks/shell/components/DeckOverlay--Scroll-UI.astro';
import { SCROLL_DECK_SEO } from '../../../../lib/seo';

const seo = SCROLL_DECK_SEO['/scroll/upward-mobility/um-p1']!;

import T01Cover         from '../../../../layouts/sections/upward-mobility/T01-Cover.astro';
import T02Arlie         from '../../../../layouts/sections/upward-mobility/T02-Arlie.astro';
import T03Problem       from '../../../../layouts/sections/upward-mobility/T03-Problem.astro';
import T04Insight       from '../../../../layouts/sections/upward-mobility/T04-Insight.astro';
import T05ABCs          from '../../../../layouts/sections/upward-mobility/T05-ABCs.astro';
import T06KpiWall       from '../../../../layouts/sections/upward-mobility/T06-KpiWall.astro';
import T07EvidenceStack from '../../../../layouts/sections/upward-mobility/T07-EvidenceStack.astro';
import T08Ladder        from '../../../../layouts/sections/upward-mobility/T08-Ladder.astro';
import T09Moment        from '../../../../layouts/sections/upward-mobility/T09-Moment.astro';
import T10Gap           from '../../../../layouts/sections/upward-mobility/T10-Gap.astro';
import T11Close         from '../../../../layouts/sections/upward-mobility/T11-Close.astro';
import T12Sources       from '../../../../layouts/sections/upward-mobility/T12-Sources.astro';
---

<!doctype html>
<html lang="en" class="theme-default" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/reach-favicon.png" />

    <MetaTags title={seo.title} description={seo.description} ogImage={seo.ogImage} />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('mode');
          var valid = ['light', 'dark', 'vibrant'];
          var sysLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
          var mode = valid.indexOf(stored) !== -1 ? stored : (sysLight ? 'light' : 'dark');
          var html = document.documentElement;
          html.setAttribute('data-mode', mode);
          if (mode === 'dark' || mode === 'vibrant') html.classList.add('dark');
          else html.classList.remove('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans is-scroll-deck" style="--deck-height: 100vh;">
    <Header />

    <PageAsDeckWrapper enableScrollSnap={true} showNavigationHints={true}>
      <T01Cover />
      <T02Arlie />
      <T03Problem />
      <T04Insight />
      <T05ABCs />
      <T06KpiWall />
      <T07EvidenceStack />
      <T08Ladder />
      <T09Moment />
      <T10Gap />
      <T11Close />
      <T12Sources />
    </PageAsDeckWrapper>

    <DeckOverlayScrollUI deckSlug="upward-mobility" variantSlug="um-p1" />

    <script>
      import '../../../../utils/mode-switcher.js';
      import '../../../../utils/deck-header-autohide.js';
    </script>
  </body>
</html>
