---
/**
 * /scroll/adult-literacy-numeracy/aln-p1/ — "The Capability Guarantee"
 *
 * Pitch-generation strategy deck (2026-07-28). Narrative source:
 * context-v/narratives/strategies (pitch.md), with canonical hex-code
 * citations from context-v/narratives/citations/registry.csv rendered as
 * sequential [n] markers ordered by first appearance (see the deck's
 * citations.ts). Token-driven via deck-primitives.css — light / dark /
 * vibrant with no per-element variant classes.
 */
import '../../../../styles/global.css';
import '../../../../styles/theme.css';
import '../../../../styles/deck-primitives.css';
import Header from '../../../../components/basics/Header.astro';
import MetaTags from '../../../../components/basics/MetaTags.astro';
import PageAsDeckWrapper from '../../../../layouts/PageAsDeckWrapper.astro';
import DeckOverlayScrollUI from '@dididecks/shell/components/DeckOverlay--Scroll-UI.astro';
import { SCROLL_DECK_SEO } from '../../../../lib/seo';

const seo = SCROLL_DECK_SEO['/scroll/adult-literacy-numeracy/aln-p1']!;

import T01Cover from '../../../../layouts/sections/adult-literacy-numeracy/T01-Cover.astro';
import T02Hook from '../../../../layouts/sections/adult-literacy-numeracy/T02-Hook.astro';
import T03BelowTheLine from '../../../../layouts/sections/adult-literacy-numeracy/T03-BelowTheLine.astro';
import T04Turn from '../../../../layouts/sections/adult-literacy-numeracy/T04-Turn.astro';
import T05Pedagogy from '../../../../layouts/sections/adult-literacy-numeracy/T05-Pedagogy.astro';
import T06Recipe from '../../../../layouts/sections/adult-literacy-numeracy/T06-Recipe.astro';
import T07Vehicle from '../../../../layouts/sections/adult-literacy-numeracy/T07-Vehicle.astro';
import T08Landscape from '../../../../layouts/sections/adult-literacy-numeracy/T08-Landscape.astro';
import T09Ask from '../../../../layouts/sections/adult-literacy-numeracy/T09-Ask.astro';
import T10TwoGeneration from '../../../../layouts/sections/adult-literacy-numeracy/T10-TwoGeneration.astro';
import T11Close from '../../../../layouts/sections/adult-literacy-numeracy/T11-Close.astro';
import T12Sources from '../../../../layouts/sections/adult-literacy-numeracy/T12-Sources.astro';
---

<!doctype html>
<html lang="en" class="theme-default" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/reach-favicon.png" />

    <MetaTags title={seo.title} description={seo.description} ogImage={seo.ogImage} />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('mode');
          var valid = ['light', 'dark', 'vibrant'];
          var sysLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
          var mode = valid.indexOf(stored) !== -1 ? stored : (sysLight ? 'light' : 'dark');
          var html = document.documentElement;
          html.setAttribute('data-mode', mode);
          if (mode === 'dark' || mode === 'vibrant') html.classList.add('dark');
          else html.classList.remove('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans is-scroll-deck" style="--deck-height: 100vh;">
    <Header />

    <PageAsDeckWrapper enableScrollSnap={true} showNavigationHints={true}>
      <T01Cover />
      <T02Hook />
      <T03BelowTheLine />
      <T04Turn />
      <T05Pedagogy />
      <T06Recipe />
      <T07Vehicle />
      <T08Landscape />
      <T09Ask />
      <T10TwoGeneration />
      <T11Close />
      <T12Sources />
    </PageAsDeckWrapper>

    <DeckOverlayScrollUI deckSlug="adult-literacy-numeracy" variantSlug="aln-p1" />

    <script>
      import '../../../../utils/mode-switcher.js';
      import '../../../../utils/deck-header-autohide.js';
    </script>
  </body>
</html>
