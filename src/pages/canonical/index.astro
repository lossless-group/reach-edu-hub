---
/**
 * Canonical layer snapshot — live counts from the augment-it reach-edu
 * workspace, published as a hub reference page. The markdown is a checked-in
 * copy at src/data/canonical-layer-snapshot.md (source of truth lives in
 * ai-labs/augment-it/clients/reach-edu/outputs/); rendered through the same
 * @lossless-group/lfm pipeline as the changelog.
 */
import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import AstroMarkdown from '../../components/markdown/AstroMarkdown.astro';
import { parseMarkdown } from '@lossless-group/lfm';
import raw from '../../data/canonical-layer-snapshot.md?raw';

const tree = await parseMarkdown(raw);
---

<BaseThemeLayout
  title="Canonical Layer Snapshot · Reach Hub"
  description="Live counts from the reach-edu canonical data layer — organizations, people, corpus items, pulse streams, and the week's additions."
>
  <article class="px-8 md:px-16 lg:px-24 py-16 md:py-20 bg-white dark:bg-slate-950 vibrant:bg-indigo-950">
    <div class="mx-auto md:max-w-[70vw]">
      <header class="border-b border-slate-200 dark:border-stone-50/15 vibrant:border-orange-500/30 pb-8 mb-10">
        <p class="flex items-baseline gap-3 flex-wrap mb-6">
          <time
            class="font-mono text-xs uppercase tracking-[0.2em] text-cyan-700 dark:text-cyan-400 vibrant:text-orange-500 tabular-nums"
            datetime="2026-08-02"
          >
            Aug 2, 2026
          </time>
          <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-orange-500">
            Data Snapshot
          </span>
        </p>

        <h1 class="font-serif text-4xl md:text-6xl text-indigo-950 dark:text-stone-50 vibrant:text-stone-50 leading-[1.05] tracking-tight mb-6">
          The Canonical Layer
        </h1>

        <p class="font-serif italic text-lg md:text-xl text-slate-700 dark:text-slate-300 vibrant:text-cyan-300 leading-relaxed">
          What the agents know: live counts from the reach-edu workspace —
          every organization, person, corpus item, and monitored stream behind
          the strategies and decks on this hub.
        </p>
      </header>

      <div class="prose-doc">
        <AstroMarkdown node={tree} />
      </div>
    </div>
  </article>

  <style is:global>
    /* Same prose treatment as the changelog body (see /changelog/[slug]),
       under its own class so the two pages can diverge independently. */
    .prose-doc {
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 0.98rem;
      line-height: 1.7;
      max-width: 48rem;
    }
    .prose-doc > * + * { margin-top: 1.1rem; }
    .prose-doc h1 { display: none; } /* page header already shows the title */
    .prose-doc h2 {
      font-family: var(--font-heading, ui-serif, Georgia, serif);
      font-size: 1.6rem;
      font-weight: 600;
      color: var(--color-text);
      line-height: 1.2;
      margin: 2.5rem 0 1rem 0;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }
    .prose-doc h3 {
      font-family: var(--font-heading, ui-serif, Georgia, serif);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--color-text);
      margin: 1.75rem 0 0.5rem 0;
    }
    .prose-doc p { margin: 0 0 1rem 0; }
    .prose-doc p:last-child { margin-bottom: 0; }
    .prose-doc strong { color: var(--color-text); font-weight: 600; }
    .prose-doc em { font-style: italic; }
    .prose-doc a {
      color: #ff8300; /* orange-saccharine */
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prose-doc a:hover { opacity: 0.8; }
    .prose-doc ul,
    .prose-doc ol { margin: 0 0 1rem 1.5rem; padding: 0; }
    .prose-doc ul { list-style: disc; }
    .prose-doc ol { list-style: decimal; }
    .prose-doc li { margin: 0 0 0.35rem 0; color: var(--color-text-muted); }
    .prose-doc li ul,
    .prose-doc li ol { margin-top: 0.35rem; }
    .prose-doc code {
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.85em;
      background: color-mix(in srgb, var(--color-border) 40%, transparent);
      border-radius: 3px;
      padding: 0.1em 0.4em;
      color: var(--color-text);
    }
    .prose-doc blockquote {
      border-left: 3px solid #ff8300;
      margin: 1.25rem 0;
      padding: 0.25rem 0 0.25rem 1rem;
      color: var(--color-text-muted);
      font-style: italic;
    }
    .prose-doc hr {
      border: 0;
      border-top: 1px solid var(--color-border);
      margin: 2rem 0;
    }
    .prose-doc table {
      width: 100%;
      font-size: 0.88rem;
      border-collapse: collapse;
      margin: 1.25rem 0;
    }
    .prose-doc th,
    .prose-doc td {
      text-align: left;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-border);
      vertical-align: top;
    }
    .prose-doc th {
      font-weight: 600;
      color: var(--color-text);
      border-bottom: 1px solid var(--color-text-muted);
      background: color-mix(in srgb, var(--color-surface) 50%, transparent);
    }
    .prose-doc td:not(:first-child),
    .prose-doc th:not(:first-child) { text-align: right; }
    .prose-doc td:not(:first-child) {
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.85em;
      font-variant-numeric: tabular-nums;
    }
  </style>
</BaseThemeLayout>
